{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurora Dict",
  "version": "2.0.0",
  "identifier": "com.aurora.dictionary",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aurora Dict",
        "width": 650,
        "height": 700,
        "minWidth": 600,
        "maxWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": true,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://dict.youdao.com https://freedictionaryapi.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' http://dict.youdao.com https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "resources/ecdict-sqlite-28.zip": "resources/ecdict-sqlite-28.zip",
      "resources/ECDICT-LICENSE.txt": "resources/ECDICT-LICENSE.txt",
      "../LICENSE": "resources/AURORA-DICT-LICENSE.txt"
    },
    "externalBin": ["binaries/llama-server"],
    "category": "Education",
    "shortDescription": "A beautiful, fast bilingual dictionary.",
    "copyright": "Copyright (c) 2026 Zhenyu Tan",
    "license": "PolyForm-Noncommercial-1.0.0",
    "licenseFile": "../LICENSE",
    "macOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
